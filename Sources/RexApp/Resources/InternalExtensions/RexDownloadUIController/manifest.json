{
  "manifest_version": 3,
  "name": "Rex Download UI Controller",
  "version": "1.0.0",
  "description": "Keeps Chromium download transport active while Rex renders the download interface.",
  "key": "",
  "permissions": [
    "downloads",
    "downloads.ui"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "incognito": "spanning"
}
